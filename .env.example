PORT=3000
APP_ENV_FILE=.env
APP_URL=http://localhost:3000
APP_NAME=Hybrid-Static-CMS
PUBLIC_LOCALE=en
SCHEDULE_TIME_ZONE=UTC
SESSION_SECRET=change-me
ACCOUNT_ENCRYPTION_KEY=change-me-separately
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hybrid_static_cms
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=change-me-now
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900
TWO_FACTOR_ENABLED=false
TWO_FACTOR_SECRET=
COOKIE_SECURE=false
TRUST_PROXY=false
PUBLIC_HTML_DIR=./public_html
CONTROL_PANEL_PATH=/control-panel
CMS_API_PREFIX=/cms-api
CMS_OUTPUT_DIR=./public_html/cms
CMS_UPLOAD_DIR=./public_html/cms/uploads
TEMPLATE_DIR=./templates
PLUGIN_DIR=./plugins
DEFAULT_PAGE_SIZE=10
MAX_UPLOAD_BYTES=20971520
ALLOW_SVG_UPLOADS=false
MEDIA_SITE_QUOTA_BYTES=0
MEDIA_USER_QUOTA_BYTES=0
MEDIA_UPLOAD_ALLOWED_ROLES=owner,admin,editor,author
MEDIA_ROLE_QUOTA_BYTES=
MEDIA_ROLE_MAX_UPLOAD_BYTES=
MEDIA_IMAGE_DERIVATIVES_ENABLED=true
MEDIA_IMAGE_MAX_WIDTH=1920
MEDIA_IMAGE_MAX_HEIGHT=1920
MEDIA_THUMBNAIL_WIDTH=480
MEDIA_THUMBNAIL_HEIGHT=320
MEDIA_WEBP_QUALITY=82
MEDIA_AVIF_QUALITY=55
MEDIA_MAX_INPUT_PIXELS=40000000
FORM_RATE_LIMIT_ATTEMPTS=5
FORM_RATE_LIMIT_WINDOW_SECONDS=300
FORM_SUBMISSION_RETENTION_DAYS=0
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS=true
SMTP_HOSTNAME=localhost
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FORM_NOTIFICATION_EMAIL=
# Optional bundled Stalwart service. Leave COMPOSE_PROFILES empty when unused.
COMPOSE_PROFILES=
STALWART_IMAGE=stalwartlabs/stalwart:v0.16
STALWART_HOSTNAME=mail.example.test
STALWART_PUBLIC_URL=http://localhost:8080
STALWART_ADMIN_PORT=8080
STALWART_BIND_ADDRESS=0.0.0.0
STALWART_SMTP_PORT=25
STALWART_HTTPS_PORT=443
STALWART_SUBMISSIONS_TLS_PORT=465
STALWART_SUBMISSION_PORT=587
STALWART_IMAPS_PORT=993
LOG_LEVEL=info
LOG_FORMAT=json
OPERATOR_ALERT_WEBHOOK_URL=
OPERATOR_ALERT_WEBHOOK_SECRET=
OPERATOR_ALERT_MIN_LEVEL=error
OPERATOR_ALERT_TIMEOUT_MS=5000
GOOGLE_FONTS_CSS_URLS=https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,1..1000&family=Noto+Sans+JP:wght@100..900&family=Noto+Sans+Mono:wght@100..900&family=Noto+Serif+JP:wght@200..900&family=Roboto:ital,wght@0,100..900;1,100..900&family=Zen+Maru+Gothic&display=swap|https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=search
GOOGLE_MAPS_EMBED_API_KEY=
OPENSTREETMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OPENSTREETMAP_ROUTING_URL=https://router.project-osrm.org
